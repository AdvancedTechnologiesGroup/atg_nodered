    {
        "id": "38ec377f59d21b23",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "function 1",
        "func": "var count = global.get(\"angleset\");\n\n// 2. Add \nif (msg.payload.payload.ticks != null)\n    count = count + msg.payload.payload.ticks;\nif (isNaN(count))\n    count = 0;\n\nif (count <= 0)\n    count = 0;\n\nif (count >= 225)\n    count = 225;\n\n// 3. Save it back to the global variable\nglobal.set(\"angleset\", count);\nglobal.set(\"anglesetreal\", count * 2);\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1020,
        "y": 180,
